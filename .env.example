# Copia este archivo como .env y ajusta los valores.

# MongoDB local (instalado o con Docker):
MONGODB_URI=mongodb://127.0.0.1:27017/quiztopia
# MongoDB Atlas (ejemplo):
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/quiztopia

# Opcional: base para `npm test`. Si no la pones, se usa MONGODB_URI con "_test" al final
# (quiztopia → quiztopia_test). Las pruebas BORRAN esa base en cada corrida.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/quiztopia_test

# Firma de las cookies de sesión (JWT). En producción usa una cadena larga y aleatoria:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

PORT=3000

# CORS: orígenes (además de este mismo servidor) que pueden llamar a la API desde un navegador.
# Separa varios con coma. Cualquier otro origen recibe 403 CORS_NOT_ALLOWED.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# NODE_ENV=production
