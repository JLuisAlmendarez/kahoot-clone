{
  "name": "quiztopia",
  "version": "2.0.0",
  "description": "Quiztopia: quizzes con versiones, intentos cronometrados y foro. Express + MongoDB + SPA sin frameworks.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "postman": "npx --yes newman@6 run docs/postman/Quiztopia.postman_collection.json"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
